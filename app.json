{
  "expo": {
    "name": "Seva Setu – Malvan Municipal Council",
    "slug": "seva-setu-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./play-store/assets/app-icon-512x512.png",
    "scheme": "sevasetuapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A4B8C",
        "foregroundImage": "./play-store/assets/app-icon-512x512.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.malvan.municipal.sevasetu"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.jpeg"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://seva-setu-app.onrender.com"
    }
  }
}
